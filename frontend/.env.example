# ============================================================
# Job4You Frontend Environment Variables Configuration
# ============================================================

# In development, the Vite server proxies '/api' to 'http://localhost:8000/api'
# For custom API backend URL, set:
VITE_API_URL=/api

# For separate deployment (e.g., frontend on Vercel/Netlify, backend on Render/AWS/VPS):
# VITE_API_URL=https://api.yourdomain.com/api

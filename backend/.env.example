# ============================================================
# Job4You Backend Environment Variables Configuration
# ============================================================

# Database Connection URL:
# For SQLite (instant local development & testing):
DATABASE_URL=sqlite:///./job4you.db

# For Production MySQL (Host, Port, User, Password, DB Name):
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/job4you

# JWT Secret & Expiration
SECRET_KEY=job4you-production-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Demo Mode & OTP Verification Bypass:
# Set to 'True' for instant developer demo (accepts 123456 or 1111 without SMS provider)
# Set to 'False' for production SMS delivery via Twilio / Fast2SMS / AWS SNS
BYPASS_OTP=True
DEMO_OTP=123456
OTP_EXPIRY_MINUTES=5

# Server Port
PORT=8000
